# Phase 1: example env vars for local setup (copy to .env / frontend/.env)

# Backend (root .env)
NODE_ENV=development
PORT=5000
MONGO_URL=mongodb://localhost:27017/proctoai
JWT_SECRET=change_me_to_a_long_random_string

# Optional email OTP (falls back to console log if unset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Frontend (frontend/.env)
# REACT_APP_BACKEND_URL=http://localhost:5000
# Phase 1: required for proctoring evidence uploads
# REACT_APP_UPLOADCARE_PUBLIC_KEY=your_uploadcare_public_key
